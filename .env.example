# ===== Supabase（P1 建好项目后填，Vercel 环境变量同名配置）=====
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=               # 公开 key（浏览器可用）
SUPABASE_SERVICE_ROLE_KEY=       # ⚠️ 绝密，只能放服务器环境变量，绝不能出现在前端代码

# ===== 邮件（QQ SMTP）=====
QQ_SMTP_USER=82839626@qq.com
QQ_SMTP_PASS=                    # QQ邮箱授权码（设置→账户→开启SMTP获得）
ADMIN_EMAIL=82839626@qq.com      # 新订单通知收件箱

# ===== 站点 =====
FRONTEND_URL=https://www.vipchinaguide.com   # 用于邮件里的链接和 CORS 白名单，多个用逗号分隔
